# Copy to .env.local and fill in. `pnpm db:start` prints the local Supabase values.
# Variables marked (launch) are optional until REQUIRE_FEATURE_KEYS=true (set on
# Vercel Production at launch); then the build fails if any is missing.
REQUIRE_FEATURE_KEYS=false

# ── App ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Supabase (local defaults from `supabase status`) ─────────────────────
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Google sign-in has no app variable: its credentials live in Supabase
# (supabase/.env locally, the dashboard in production). See docs/auth-setup.md.

# ── AI receptionist ──────────────────────────────────────────────────────
# gemini | anthropic | mock. Switching provider is a config change, not a code change.
# mock: a scripted model with no key, for Playwright (CI) and UI work. Refused on Vercel Production.
AI_PROVIDER=gemini
# Optional: defaults to gemini-3.5-flash-lite (gemini) or claude-haiku-5-5 (anthropic).
AI_MODEL=
# (launch) The key for the provider AI_PROVIDER picks. Without it the chat answers 503.
GOOGLE_GENERATIVE_AI_API_KEY=
ANTHROPIC_API_KEY=
# Optional: customer messages a day the AI answers across all businesses (default 200).
AI_DAILY_REQUEST_CAP=

# ── Email: Resend ────────────────────────────────────────────────────────
# (launch) Staff invites (and later booking emails). Unset locally: the invite link is
# logged to the server console instead, and owners can copy it in the app.
RESEND_API_KEY=
EMAIL_FROM="Slotwren <bookings@slotwren.com>"

# ── Billing: Stripe (test mode) ──────────────────────────────────────────
STRIPE_SECRET_KEY=               # (launch)
STRIPE_WEBHOOK_SECRET=           # (launch)
STRIPE_PRO_PRICE_ID=             # (launch)

# ── Background jobs: Inngest (dev server needs no keys) ──────────────────
INNGEST_EVENT_KEY=               # (launch)
INNGEST_SIGNING_KEY=             # (launch)
# Locally: INNGEST_DEV=1 and run `pnpm jobs:dev` (the Inngest dev server). Never in production.
INNGEST_DEV=

# ── Rate limiting: Upstash ───────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=          # (launch)
UPSTASH_REDIS_REST_TOKEN=        # (launch)

# ── Monitoring: Sentry ───────────────────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

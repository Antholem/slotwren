# Copy to .env.local and fill in. `pnpm db:start` prints the local Supabase values.
# Variables marked (launch) are optional until REQUIRE_FEATURE_KEYS=true (set on
# Vercel Production at launch); then the build fails if any is missing.
REQUIRE_FEATURE_KEYS=false

# ── App ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Supabase (local defaults from `supabase status`) ─────────────────────
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ── AI receptionist ──────────────────────────────────────────────────────
# gemini | anthropic. Switching provider is a config change, not a code change.
AI_PROVIDER=gemini
# (launch) e.g. a current Gemini Flash model id, or claude-haiku-5-5 for anthropic
AI_MODEL=
GOOGLE_GENERATIVE_AI_API_KEY=
ANTHROPIC_API_KEY=

# ── Email: Resend ────────────────────────────────────────────────────────
RESEND_API_KEY=                  # (launch)
EMAIL_FROM="Slotwren <bookings@slotwren.com>"

# ── Billing: Stripe (test mode) ──────────────────────────────────────────
STRIPE_SECRET_KEY=               # (launch)
STRIPE_WEBHOOK_SECRET=           # (launch)
STRIPE_PRO_PRICE_ID=             # (launch)

# ── Background jobs: Inngest (dev server needs no keys) ──────────────────
INNGEST_EVENT_KEY=               # (launch)
INNGEST_SIGNING_KEY=             # (launch)

# ── Rate limiting: Upstash ───────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=          # (launch)
UPSTASH_REDIS_REST_TOKEN=        # (launch)

# ── Monitoring: Sentry ───────────────────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

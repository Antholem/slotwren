# Copy to .env.local and fill in. `pnpm db:start` prints the local Supabase values.
# Variables marked (prod) are optional locally and required on a production deploy.

# ── App ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Supabase (local defaults from `supabase status`) ─────────────────────
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ── AI receptionist ──────────────────────────────────────────────────────
# gemini | anthropic. Switching provider is a config change, not a code change.
AI_PROVIDER=gemini
# (prod) e.g. a current Gemini Flash model id, or claude-haiku-5-5 for anthropic
AI_MODEL=
GOOGLE_GENERATIVE_AI_API_KEY=
ANTHROPIC_API_KEY=

# ── Email: Resend ────────────────────────────────────────────────────────
RESEND_API_KEY=                  # (prod)
EMAIL_FROM="Slotwren <bookings@slotwren.com>"

# ── Billing: Stripe (test mode) ──────────────────────────────────────────
STRIPE_SECRET_KEY=               # (prod)
STRIPE_WEBHOOK_SECRET=           # (prod)
STRIPE_PRO_PRICE_ID=             # (prod)

# ── Background jobs: Inngest (dev server needs no keys) ──────────────────
INNGEST_EVENT_KEY=               # (prod)
INNGEST_SIGNING_KEY=             # (prod)

# ── Rate limiting: Upstash ───────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=          # (prod)
UPSTASH_REDIS_REST_TOKEN=        # (prod)

# ── Monitoring: Sentry ───────────────────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
